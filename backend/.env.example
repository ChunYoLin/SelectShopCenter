# PostgreSQL 連線字串
# 格式: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/japan_select_shops?schema=public"

# 爬蟲設定
SCRAPER_HEADLESS=true          # 是否以無頭模式執行 Playwright
SCRAPER_MIN_DELAY_MS=1500      # 每個請求之間的最小延遲 (ms)
SCRAPER_MAX_DELAY_MS=3500      # 每個請求之間的最大延遲 (ms)
SCRAPER_MAX_PAGES=3            # ARKnets 品牌頁最多翻頁數 (避免過度抓取)
SHOPIFY_MAX_PAGES=130         # diverse(Shopify) 全目錄分頁防呆上限 (250 筆/頁)
