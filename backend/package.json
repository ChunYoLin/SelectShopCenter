{
  "name": "@japan-select-shops/backend",
  "version": "0.1.0",
  "private": true,
  "description": "日本選品店情報聚合平台 - 後端與爬蟲",
  "type": "commonjs",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "scrape:arknets": "LD_LIBRARY_PATH=\"$PWD/.native-libs:$LD_LIBRARY_PATH\" ts-node src/index.ts arknets",
    "scrape:diverse": "ts-node src/index.ts diverse",
    "scrape:loftman": "ts-node src/index.ts loftman",
    "scrape:all": "LD_LIBRARY_PATH=\"$PWD/.native-libs:$LD_LIBRARY_PATH\" ts-node src/index.ts all",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.5",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
